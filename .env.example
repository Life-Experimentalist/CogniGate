# =============================================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the `.env` file to version control.
# =============================================================================

# --- Gateway (Go Edge Proxy) ---
# The admin-plane bootstrap credential. It is the only key that exists before
# any tenant does, so it is how the first tenant — and the first API key — gets
# created. Must be at least 16 characters. The placeholder below is deliberately
# shorter than that, so a copy of this file left unedited is refused at startup
# rather than becoming a deployment whose admin credential is published here.
# Generate with: openssl rand -hex 24
GATEWAY_BOOTSTRAP_KEY=replace_me

# --- Analytics (Spring Boot Domain Engine) ---
# Full JDBC URL pointing to the PostgreSQL database.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-db:5432/cognigate

# PostgreSQL credentials
SPRING_DATASOURCE_USERNAME=cognigate_user
SPRING_DATASOURCE_PASSWORD=cognigate_pass

# The shared secret between the gateway and the analytics service. Both are
# given this same value, and it is the only thing standing between /api/** —
# which is how usage records are written — and anyone who can reach port
# 8081. Neither service starts without it, so a copy of this file left
# unedited is refused rather than becoming a deployment whose credential is
# published here.
#
# If the two sides disagree, the analytics service answers 401. The gateway
# treats a 4xx as permanent and drops the record after one attempt, so a
# mistyped token loses metering quietly — check the gateway's logs for
# "usage record could not be persisted" after changing it.
#
# Generate with: openssl rand -hex 32
ANALYTICS_TOKEN=replace_me

# --- PostgreSQL (Docker) ---
POSTGRES_DB=cognigate
POSTGRES_USER=cognigate_user
POSTGRES_PASSWORD=cognigate_pass

# --- Optional: GHCR Image Tags (used by docker-publish workflow) ---
# IMAGE_TAG=latest
