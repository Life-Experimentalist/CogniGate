# =============================================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the `.env` file to version control.
# =============================================================================

# --- Gateway (Go Edge Proxy) ---
# Address of the Redis server (host:port). No protocol prefix needed.
REDIS_URL=redis:6379

# --- Analytics (Spring Boot Domain Engine) ---
# Full JDBC URL pointing to the PostgreSQL database.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-db:5432/cognigate

# PostgreSQL credentials
SPRING_DATASOURCE_USERNAME=cognigate_user
SPRING_DATASOURCE_PASSWORD=cognigate_pass

# AES-256-GCM master key for encrypting provider API keys.
# MUST be exactly 32 bytes encoded as a 64-character hex string.
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=replace_with_32_byte_hex_key_here_minimum_64_chars

# --- PostgreSQL (Docker) ---
POSTGRES_DB=cognigate
POSTGRES_USER=cognigate_user
POSTGRES_PASSWORD=cognigate_pass

# --- Optional: GHCR Image Tags (used by docker-publish workflow) ---
# IMAGE_TAG=latest
